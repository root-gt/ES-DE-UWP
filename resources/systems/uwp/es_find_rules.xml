        </rule>
    </emulator>
    <emulator name="DUCKSTATION">
        <rule type="uwpprotocol">
            <entry>duckstation:?cmd=duckstation.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="FLYCAST">
        <rule type="uwpprotocol">
            <entry>flycast:?cmd=flycast.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="CEMU">
        <rule type="uwpprotocol">
            <entry>cemu:?cmd=cemu.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="XEMU">
        <rule type="uwpprotocol">
            <entry>xemu:?cmd=xemu.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="XENIA">
        <rule type="uwpprotocol">
            <entry>xeniacanary:?cmd=xeniacanary.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="AZAHAR">
        <rule type="uwpprotocol">
            <entry>azahar:?cmd=azahar.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="CITRA">
        <!-- The Citra based UWP port is called Citrara. -->
        <rule type="uwpprotocol">
            <entry>citrara:?cmd=citrara.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="LIME3DS">
        <rule type="uwpprotocol">
            <entry>azahar:?cmd=azahar.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="SUPERMODEL">
        <rule type="uwpprotocol">
            <entry>supermodel:?cmd=supermodel.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <!-- Unverified protocol names, adjust if needed. -->
    <emulator name="RPCS3">
        <rule type="uwpprotocol">
            <entry>rpcs3:?cmd=rpcs3.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
    <emulator name="SHADPS4">
        <rule type="uwpprotocol">
            <entry>shadps4:?cmd=shadps4.exe %ARGS%&amp;launchOnExit=%RETURNURI%</entry>
        </rule>
    </emulator>
</ruleList>
